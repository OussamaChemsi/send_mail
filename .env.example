# SMTP server configuration
smtp_host="smtp.gmail.com"
smtp_port="465"
smtp_use_ssl="true"
smtp_timeout="30"

# Sender credentials
gmail_sender="your.email@gmail.com"
sender_name="Your Name"
gmail_app_key="xxxx xxxx xxxx xxxx"

# Recipients (comma, semicolon, or newline separated)
mail_list="hr@company1.example.com, careers@company2.example.com"

# Email message (use \n or multiple lines inside quotes)
mail_subject="Application for Software Engineer Position - Your Name"
mail_content="Dear Hiring Team,

I hope this email finds you well.

I am writing to express my interest in Software Engineer opportunities at your company. Please find my CV attached in PDF format for your review.

I would welcome the opportunity to discuss how my skills and experience can contribute to your team. Thank you for your time and consideration.

Best regards,
Your Name"
mail_is_html="false"

# PDF attachments (file path, or comma/newline-separated paths; leave empty for none)
pdf_attachments="cv.pdf"

# Runtime options
send_delay="1"
dry_run="true" # true = simulation mode (preview only), false = send real emails

